# Natpudan v2.0 Enterprise - Environment Configuration Template
# Copy this to .env and fill in your values

# =============================================================================
# CORE APPLICATION
# =============================================================================
APP_ENV=development  # development | staging | production
DEBUG=true
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR | CRITICAL

# Database
DATABASE_URL=sqlite:///./data/natpudan.db
# For PostgreSQL: postgresql://user:password@localhost:5432/natpudan
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# =============================================================================
# FEATURE 1 & 5: VOICE & AMBIENT TRANSCRIPTION
# =============================================================================
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4
WHISPER_MODEL=whisper-1

# Voice file storage
VOICE_STORAGE_DIR=backend/data/voice_recordings
MAX_VOICE_FILE_SIZE_MB=25
VOICE_RETENTION_DAYS=30  # Auto-delete after 30 days (HIPAA)

# Transcription settings
VOICE_LANGUAGE=en
VOICE_CONFIDENCE_THRESHOLD=0.7  # Only process if > 70% confidence

# =============================================================================
# FEATURE 2: WEARABLE DEVICE INTEGRATION
# =============================================================================

# Fitbit OAuth
FITBIT_CLIENT_ID=your_fitbit_app_id
FITBIT_CLIENT_SECRET=your_fitbit_secret
FITBIT_REDIRECT_URI=http://localhost:3000/api/wearable/callback/fitbit
FITBIT_USE_SANDBOX=false  # Set to true for testing

# Apple Health (OAuth)
APPLE_HEALTH_TEAM_ID=your_team_id
APPLE_HEALTH_CLIENT_ID=your_client_id
APPLE_HEALTH_REDIRECT_URI=http://localhost:3000/api/wearable/callback/apple

# Garmin Connect (OAuth)
GARMIN_CLIENT_ID=your_client_id
GARMIN_CLIENT_SECRET=your_secret
GARMIN_REDIRECT_URI=http://localhost:3000/api/wearable/callback/garmin

# Wearable sync settings
WEARABLE_SYNC_INTERVAL_MINUTES=5  # Sync every 5 minutes
WEARABLE_DATA_RETENTION_MONTHS=12
WEARABLE_TOKEN_ENCRYPTION_KEY=your-256-bit-base64-key  # For token storage

# =============================================================================
# FEATURE 3: PREDICTIVE READMISSION ALERTS
# =============================================================================

# Machine Learning
ML_MODEL_PATH=backend/data/models/
ML_TRAINING_DATA_RETENTION_DAYS=365
ML_MODEL_RETRAIN_SCHEDULE=weekly  # daily | weekly | monthly
ML_CONFIDENCE_THRESHOLD=0.6

# Readmission prediction
READMISSION_RISK_SCORE_THRESHOLD_HIGH=0.7
READMISSION_RISK_SCORE_THRESHOLD_MEDIUM=0.5
READMISSION_RISK_SCORE_THRESHOLD_LOW=0.3

# Alert routing
ALERT_CRITICAL_CHANNELS=sms,email,push  # Multi-channel for critical
ALERT_HIGH_CHANNELS=email,push
ALERT_MEDIUM_CHANNELS=push
ALERT_LOW_CHANNELS=push

# =============================================================================
# FEATURE 4: KNOWLEDGE GRAPH VISUALIZATION
# =============================================================================

# Knowledge base
KB_STORAGE_DIR=backend/data/knowledge_base
KB_INDEX_TYPE=faiss  # faiss | milvus | elasticsearch
KB_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
KB_CHUNK_SIZE=500
KB_CHUNK_OVERLAP=50

# Graph visualization
KNOWLEDGE_GRAPH_MAX_NODES=1000
KNOWLEDGE_GRAPH_MAX_HOPS=3
KNOWLEDGE_GRAPH_MIN_CONFIDENCE=0.6

# =============================================================================
# FEATURE 6-15: FUTURISTIC FEATURES
# =============================================================================

# Notifications (Smart Notification Engine)
NOTIFICATION_PROVIDER=twilio  # twilio | sendgrid | aws_sns | vonage
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Email notifications
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your-email@gmail.com
EMAIL_SMTP_PASSWORD=your-app-password
EMAIL_FROM_ADDRESS=healthcare@natpudan.example.com
EMAIL_FROM_NAME=Natpudan AI

# Push notifications
PUSH_NOTIFICATION_PROVIDER=firebase  # firebase | expo
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY_PATH=backend/config/firebase-key.json

# FHIR Healthcare Connector
FHIR_SERVER_URL=https://fhir.example.com/fhir
FHIR_AUTH_TOKEN=your_fhir_token
FHIR_ENABLE_EXPORT=true
FHIR_ENABLE_IMPORT=true

# Real-time Analytics
ANALYTICS_LOCATION_API=google_maps  # google_maps | mapbox | here
ANALYTICS_LOCATION_API_KEY=your_api_key
ANALYTICS_HEATMAP_RADIUS_MILES=50

# Multi-Language AI
TRANSLATION_SERVICE=google_translate  # google_translate | azure | aws
GOOGLE_TRANSLATE_API_KEY=your_key
DETECTED_LANGUAGE_MIN_CONFIDENCE=0.8

# Genomics Integration
PHARMACOGENOMICS_PROVIDER=customhealth  # customhealth | mygenome | myriad
PHARMACOGENOMICS_API_KEY=your_key
PHARMACOGENOMICS_BASE_URL=https://api.pharmacogenomics.example.com
ANCESTRY_ADJUSTED_DOSING=true  # Use ancestry in dosing calculations

# Clinical Trial Matcher
CLINICAL_TRIALS_API_KEY=your_api_key  # ClinicalTrials.gov API
CLINICAL_TRIALS_BASE_URL=https://clinicaltrials.gov/api/v2

# Public Health Surveillance
SURVEILLANCE_OUTBREAK_THRESHOLD=5  # Alert if 5+ cases in 7 days
SURVEILLANCE_ENABLE_WHO_REPORTING=false  # Enable automatic WHO reports
SURVEILLANCE_ALERT_HEALTH_DEPT=true
HEALTH_DEPT_EMAIL=surveillance@publichealth.gov

# =============================================================================
# SECURITY & COMPLIANCE
# =============================================================================

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://app.natpudan.example.com

# Authentication
JWT_SECRET_KEY=your-super-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# API Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD_SECONDS=60

# HIPAA Compliance
HIPAA_AUDIT_LOGGING=true
HIPAA_ENCRYPTION_AT_REST=true
PHI_RETENTION_DAYS=2555  # 7 years for medical records

# =============================================================================
# MONITORING & LOGGING
# =============================================================================

# Sentry (Error tracking)
SENTRY_DSN=https://your-key@sentry.io/your-project-id
SENTRY_ENVIRONMENT=production

# Application Insights (Azure)
APPLICATION_INSIGHTS_INSTRUMENTATION_KEY=your_key

# CloudWatch (AWS)
AWS_REGION=us-east-1
CLOUDWATCH_LOG_GROUP=natpudan-logs

# Datadog
DATADOG_API_KEY=your_api_key
DATADOG_APP_KEY=your_app_key

# =============================================================================
# DEVELOPMENT & TESTING
# =============================================================================

# Testing
TEST_DATABASE_URL=sqlite:///./test.db
TEST_DATA_SEED=true  # Auto-seed test data on startup

# Mock services (for development)
MOCK_OPENAI_RESPONSES=false
MOCK_WEARABLE_DATA=false
MOCK_ML_PREDICTIONS=false

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Quick-Win Features (5)
FEATURE_VOICE_DOCUMENTATION=true
FEATURE_WEARABLE_INTEGRATION=true
FEATURE_READMISSION_ALERTS=true
FEATURE_KNOWLEDGE_GRAPH=true
FEATURE_AMBIENT_TRANSCRIPTION=true

# Futuristic Features (10)
FEATURE_XAI=true
FEATURE_TREATMENT_RECOMMENDER=true
FEATURE_DISCHARGE_PLANNING=true
FEATURE_CLINICAL_TRIALS=true
FEATURE_SMART_NOTIFICATIONS=true
FEATURE_FHIR_CONNECTOR=true
FEATURE_ANALYTICS=true
FEATURE_MULTILINGUAL=true
FEATURE_GENOMICS=true
FEATURE_SURVEILLANCE=true

# =============================================================================
# NOTES
# =============================================================================

# 1. Ensure OPENAI_API_KEY is set for voice & NLP features
# 2. Wearable OAuth requires credentials from each provider's developer console
# 3. For HTTPS deployment, ensure FHIR_SERVER_URL uses https://
# 4. Keep JWT_SECRET_KEY secure; rotate regularly in production
# 5. Monitor ML model performance; retrain if accuracy drops > 5%
# 6. HIPAA compliance requires HIPAA_ENCRYPTION_AT_REST=true in production
# 7. For multi-tenant deployments, use database row-level security
